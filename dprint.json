{
  "lineWidth": 80,
  "typescript": {
    "indentWidth": 2
  },
  "json": {
  },
  "markdown": {
  },
  "excludes": [
    "**/dist",
    "**/node_modules",
    "**/*-lock.json"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.101.0",
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "https://plugins.dprint.dev/disrupted/css-0.2.3.wasm",
    "npm:dprint-plugin-malva@0.16.1"
  ]
}
