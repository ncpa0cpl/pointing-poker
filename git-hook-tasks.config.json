{
  "packageManager": "yarn",
  "parallel": true,
  "hooks": {
    "pre-push": [
      {
        "name": "TypeScript",
        "script": "test:tsc"
      },
      {
        "name": "Formatting",
        "script": "test:fmt"
      },
      {
        "mustRunAlone": true,
        "name": "Unit&Integration Tests",
        "script": "test"
      }
    ],
    "pre-commit": [],
    "post-commit": []
  }
}
