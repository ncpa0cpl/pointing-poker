  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "fmt": "dprint fmt",
    "test:fmt": "dprint check",
    "test:tsc": "tsc --noEmit && tsc --noEmit -p tests",
    "test:docker:up": "docker compose -f docker-compose.test.yml up -d --build --wait",
    "test:docker:down": "docker compose -f docker-compose.test.yml down",
    "test:server": "NODE_EXTRA_CA_CERTS=$PWD/tests/nginx/certs/ca.crt bun test ./tests/live",
    "test:smoke": "playwright test",
    "test:run": "bun run test:server && bun run test:smoke",
    "test": "bun run test:docker:up && bun run test:run ; bun run test:docker:down",
    "start": "bun ./src/server/start.ts",
    "start:dev": "NODE_ENV=development node ./scripts/build.mjs --watch --serve --dev",
    "watch": "NODE_ENV=development node ./scripts/build.mjs --watch",
    "build:dev": "NODE_ENV=development node --env-file=.env ./scripts/build.mjs --dev",
    "build:prod": "NODE_ENV=production node --env-file=.env ./scripts/build.mjs",
    "gen:icon": "magick convert -background transparent -define 'icon:auto-resize=16,24,32,64,128' icon.svg ./src/server/routes/spa/favicon.ico",
    "prepare": "git-hook-tasks install -p bun"
  },
  "resolutions": {
    "@ncpa0cpl/vanilla-jsx": "^0.0.1-alpha.56"
  },
  "dependencies": {
    "@ncpa0cpl/mutex.js": "^1.0.1",
    "@ncpa0cpl/vanilla-jsx": "^0.0.1-alpha.56",
    "@ncpa0cpl/vrouter": "^0.0.15",
