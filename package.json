    "crc-32": "^1.2.2",
    "dedent": "^1.7.2",
    "dprint": "^0.65.0",
    "esbuild": "^0.28.2",
    "git-hook-tasks": "git+https://github.com/ncpa0cpl/git-hook-tasks#2.0.7",
    "husky": "^8.0.3",
