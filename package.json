    "adwavecss": "0.4.1",
    "adwaveui": "^0.4.1",
    "dilswer": "^3.2.3",
    "escape-html": "^1.0.3",
    "http-status-codes": "^2.3.0",
    "jsdom-global": "^3.0.2",
    "luxon": "^3.7.2",
    "marked": "^11.1.1",
    "reflect-metadata": "^0.2.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@ncpa0cpl/nodepack": "2.5.1",
    "@playwright/test": "^1.65.1",
    "@sentry/cli": "^3.8.2",
    "@types/bun": "^1.4.4",
    "@types/escape-html": "^1.0.4",
