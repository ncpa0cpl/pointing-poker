{
  "languages": {
    "JavaScript": {
      "language_servers": ["typescript-ls"],
      "code_actions_on_format": {
        "source.organizeImports": true
      },
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"]
        }
      }
    },
    "TypeScript": {
      "language_servers": ["typescript-ls"],
      "code_actions_on_format": {
        "source.organizeImports": true
      },
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"]
        }
      }
    },
    "TSX": {
      "language_servers": ["typescript-ls"],
      "code_actions_on_format": {
        "source.organizeImports": true
      },
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"]
        }
      }
    },
    "CSS": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["run", "dprint", "fmt", "--stdin", "{buffer_path}"]
        }
      }
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["run", "dprint", "fmt", "--stdin", "{buffer_path}"]
        }
      }
    }
  },
  "lsp": {
    "eslint": {}
  }
}
